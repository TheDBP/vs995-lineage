From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheDBP <TheDBP@users.noreply.github.com>
Date: Mon, 5 Oct 2026 17:22:49 -0400
Subject: [PATCH] msm8996-common: LG IPsec helpers so the IMS REGISTER security
 agreement completes (200 OK)

libims (com.lge.ims, uid radio) does not program xfrm itself. After the
P-CSCF's 401 (Security-Server, port-c/port-s) it asks ipsecstarter over the
abstract unix dgram socket @/tmp/ims/socket/ipsec_controller to start
ipsecclient, which installs the ESP SAs/SPs via netlink xfrm and serves
@/tmp/ims/socket/ipsec_proxy. Without the pair, "add policy is failed" tears
the registration down and it retries forever. With it the authenticated
REGISTER gets 200 OK and the stack reaches STATE_REGISTERED.

Ship the stock 32-bit /system/bin helpers as cc_prebuilt_binary (staged by
build-ims4.sh step 7, not committed; liblog listed for check_elf_file), the
stock init services (starter: uid system; client: root, disabled, started
on demand through ctl.start), and product-private sepolicy: ipsecstarter and
ipsecclient coredomains, exec labels, and ctl.start$ipsecclient as a
system_internal_prop (a coredomain may only set system_property_type).

---
 ims/.gitignore                     |  2 ++
 ims/Android.bp                     | 31 ++++++++++++++++++++++++++++++
 ims/build-ims4.sh                  | 12 +++++++++++-
 ims/ims.mk                         |  7 +++++++
 ims/lge-ims-ipsec.rc               | 14 ++++++++++++++
 sepolicy/private/file_contexts     |  3 +++
 sepolicy/private/lge_ims_ipsec.te  | 27 ++++++++++++++++++++++++++
 sepolicy/private/property_contexts |  3 +++
 8 files changed, 98 insertions(+), 1 deletion(-)
 create mode 100644 ims/lge-ims-ipsec.rc
 create mode 100644 sepolicy/private/file_contexts
 create mode 100644 sepolicy/private/lge_ims_ipsec.te
 create mode 100644 sepolicy/private/property_contexts

diff --git a/ims/.gitignore b/ims/.gitignore
index 4813e6f3..965f3296 100644
--- a/ims/.gitignore
+++ b/ims/.gitignore
@@ -2,3 +2,5 @@
 .work/
 Ims4-reworked.apk
 .push-sysapp/
+ipsecstarter
+ipsecclient
diff --git a/ims/Android.bp b/ims/Android.bp
index b5fbbfb0..e65d58f2 100644
--- a/ims/Android.bp
+++ b/ims/Android.bp
@@ -15,3 +15,34 @@ android_app_import {
         enabled: false,
     },
 }
+
+// LG's IPsec helpers for the SIP REGISTER security agreement (RFC 3329 ipsec-3gpp). libims (inside
+// com.lge.ims, uid radio) does not program xfrm itself: it asks ipsecstarter (uid system) over the
+// ABSTRACT unix dgram socket @/tmp/ims/socket/ipsec_controller to `ctl.start ipsecclient` (root),
+// which installs the ESP SAs/SPs via netlink xfrm and serves @/tmp/ims/socket/ipsec_proxy. Abstract
+// names -- no /tmp directory exists or is needed. Without them the 401-challenged REGISTER dies at
+// "add policy is failed". Stock 32-bit /system/bin binaries, staged here by build-ims4.sh step 7,
+// not committed. Only libc/libcutils/libc++ deps, so they run unmodified on A17. liblog is listed
+// even though it is not a DT_NEEDED: check_elf_file resolves __android_log_print against the listed
+// libs only (stock reached it through libcutils).
+cc_prebuilt_binary {
+    name: "ipsecstarter",
+    srcs: ["ipsecstarter"],
+    shared_libs: ["libcutils", "liblog", "libc++", "libc", "libm", "libdl"],
+    compile_multilib: "32",
+    strip: {
+        none: true,
+    },
+    init_rc: ["lge-ims-ipsec.rc"],
+    required: ["ipsecclient"],
+}
+
+cc_prebuilt_binary {
+    name: "ipsecclient",
+    srcs: ["ipsecclient"],
+    shared_libs: ["libcutils", "liblog", "libc++", "libc", "libm", "libdl"],
+    compile_multilib: "32",
+    strip: {
+        none: true,
+    },
+}
diff --git a/ims/build-ims4.sh b/ims/build-ims4.sh
index 9e4ad188..33ec056e 100755
--- a/ims/build-ims4.sh
+++ b/ims/build-ims4.sh
@@ -5,7 +5,7 @@
 # rom-forge/docs/debugging-volte.md "Rework an OEM legacy IMS app".
 #
 #   build-ims4.sh <Ims4.apk> <boot-ims-common.oat> <system.image|bootcp-dir> <framework-smali-dir> \
-#                 <stock-libs-dir> <out.apk>
+#                 <stock-libs-dir> <out.apk> [<stock-bin-dir>]   (bin dir default: <stock-libs-dir>/../bin)
 #
 # Proprietary inputs (NOT committed -- stage them): the stock Ims4.apk, boot-ims-common.oat and a stock
 # system image (for the deodex boot classpath), a framework deodex that holds the com.android.ims AIDL
@@ -127,3 +127,13 @@ cp "$APK" "$OUT"
 (cd "$T" && zip -q "$OUT" classes.dex && zip -q -0 -X -r "$OUT" lib)
 zip -q -d "$OUT" 'META-INF/*' >/dev/null 2>&1 || true
 echo ">> built $OUT ($(stat -c %s "$OUT") bytes, $(unzip -l "$OUT" | grep -c 'lib/armeabi-v7a/.*\.so') libs bundled) -- unsigned, for android_app_import certificate:platform"
+
+echo ">> 7. stage the IPsec helpers (stock 32-bit /system/bin, uncommitted; ims/Android.bp cc_prebuilt_binary)"
+# libims installs the REGISTER security agreement's ESP SAs through LG's ipsecstarter -> ipsecclient
+# (netlink xfrm), not by itself; without them registration dies at "add policy is failed".
+STOCKBIN="${7:-$(dirname "$STOCKLIBS")/bin}"
+for b in ipsecstarter ipsecclient; do
+  [ -f "$STOCKBIN/$b" ] || { echo "!! $STOCKBIN/$b missing (stock 32-bit /system/bin; pass <stock-bin-dir> as arg 7)" >&2; exit 1; }
+  cp -f "$STOCKBIN/$b" "$HERE/$b"; chmod 755 "$HERE/$b"
+done
+echo "   staged ipsecstarter ipsecclient -> $HERE"
diff --git a/ims/ims.mk b/ims/ims.mk
index 032e2d27..3deee462 100644
--- a/ims/ims.mk
+++ b/ims/ims.mk
@@ -9,6 +9,13 @@ PRODUCT_PACKAGES += \
     libimscompat \
     Ims4
 
+# IPsec helpers for the SIP security agreement (ims/Android.bp): stock ipsecstarter/ipsecclient,
+# staged by build-ims4.sh. libims hands the ESP SAs to them over abstract unix sockets; without them
+# the 401-challenged REGISTER never completes.
+PRODUCT_PACKAGES += \
+    ipsecstarter \
+    ipsecclient
+
 # Ims4 is a priv-app requesting signature|privileged perms; without this allowlist system_server
 # FATALs at onSystemReady (a framework check, not SELinux). Generated from aapt dump permissions.
 PRODUCT_COPY_FILES += \
diff --git a/ims/lge-ims-ipsec.rc b/ims/lge-ims-ipsec.rc
new file mode 100644
index 00000000..f18ca80e
--- /dev/null
+++ b/ims/lge-ims-ipsec.rc
@@ -0,0 +1,14 @@
+# LG IMS IPsec helpers, as in stock init.elsa_product.rc. ipsecstarter (uid system) listens on the
+# abstract socket @/tmp/ims/socket/ipsec_controller and ctl.start/stop's ipsecclient when libims asks.
+# ipsecclient (root: netlink xfrm) serves @/tmp/ims/socket/ipsec_proxy; it EXITS at once if
+# com.lge.ims's @/tmp/ims/socket/ipsec_user is not bound, so it is start-on-demand only -- never
+# start it at boot or by hand. See IMS.md "REGISTER/IPsec".
+service ipsecstarter /system/bin/ipsecstarter
+    class main
+    user system
+    group system net_admin net_raw
+
+service ipsecclient /system/bin/ipsecclient
+    class main
+    group system net_admin net_raw
+    disabled
diff --git a/sepolicy/private/file_contexts b/sepolicy/private/file_contexts
new file mode 100644
index 00000000..2d6e43ac
--- /dev/null
+++ b/sepolicy/private/file_contexts
@@ -0,0 +1,3 @@
+# LG IMS IPsec helpers (ims/Android.bp, lge_ims_ipsec.te)
+/system/bin/ipsecstarter    u:object_r:ipsecstarter_exec:s0
+/system/bin/ipsecclient     u:object_r:ipsecclient_exec:s0
diff --git a/sepolicy/private/lge_ims_ipsec.te b/sepolicy/private/lge_ims_ipsec.te
new file mode 100644
index 00000000..209ef797
--- /dev/null
+++ b/sepolicy/private/lge_ims_ipsec.te
@@ -0,0 +1,27 @@
+# LG IMS IPsec helpers (ims/lge-ims-ipsec.rc): libims in com.lge.ims (radio) -> ipsecstarter (system)
+# -> ctl.start ipsecclient (root, netlink xfrm). The three talk over ABSTRACT unix dgram sockets
+# @/tmp/ims/socket/{ipsec_user,ipsec_controller,ipsec_proxy}: no file labels, only the peer domains'
+# socket types are checked. radio is permissive for bringup (ims.te); its rules are still listed here
+# so the set is complete when that is removed.
+type ipsecstarter, domain, coredomain;
+type ipsecstarter_exec, exec_type, file_type, system_file_type;
+init_daemon_domain(ipsecstarter)
+allow ipsecstarter self:unix_dgram_socket create_socket_perms_no_ioctl;
+allow ipsecstarter { radio ipsecclient }:unix_dgram_socket sendto;
+# ctl.start$ipsecclient / ctl.stop$ipsecclient on libims's UP/DOWN (property_contexts)
+set_prop(ipsecstarter, ctl_ipsec_prop)
+
+type ipsecclient, domain, coredomain;
+type ipsecclient_exec, exec_type, file_type, system_file_type;
+init_daemon_domain(ipsecclient)
+allow ipsecclient self:global_capability_class_set net_admin;
+allow ipsecclient self:netlink_xfrm_socket { create_socket_perms_no_ioctl nlmsg_write nlmsg_read };
+# rtnl_open_byproto() also opens a NETLINK_ROUTE socket
+allow ipsecclient self:netlink_route_socket { create_socket_perms_no_ioctl nlmsg_write nlmsg_read };
+allow ipsecclient self:unix_dgram_socket create_socket_perms_no_ioctl;
+allow ipsecclient { radio ipsecstarter }:unix_dgram_socket sendto;
+
+allow radio self:unix_dgram_socket create_socket_perms_no_ioctl;
+allow radio { ipsecstarter ipsecclient }:unix_dgram_socket sendto;
+
+system_internal_prop(ctl_ipsec_prop)
diff --git a/sepolicy/private/property_contexts b/sepolicy/private/property_contexts
new file mode 100644
index 00000000..7215af0b
--- /dev/null
+++ b/sepolicy/private/property_contexts
@@ -0,0 +1,3 @@
+# ipsecstarter starts/stops ipsecclient (lge_ims_ipsec.te)
+ctl.start$ipsecclient    u:object_r:ctl_ipsec_prop:s0
+ctl.stop$ipsecclient     u:object_r:ctl_ipsec_prop:s0
