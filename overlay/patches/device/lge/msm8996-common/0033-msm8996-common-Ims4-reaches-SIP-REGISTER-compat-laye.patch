+def hook_isim_state_monitor(root):
+    # LG telephony-common's LGImsIsimHandler (sticky com.lge.ims.ISIM_STATE_CHANGED) and the
+    # com.lge.ims.phone IIMSPhone service are absent, so nobody tells SIMStateAgent the ISIM is LOADED
+    # -> SUBSCRIBERINCOMPLETED forever. Start TelephonyCompat's in-process publisher of that sticky
+    # intent from SIMStateAgent.<init> (the consumer). Idempotent.
+    f = os.path.join(root, 'com/lge/ims/common/agents/SIMStateAgent.smali')
+    if not os.path.exists(f): return False
+    s = open(f).read()
+    hook = 'invoke-static {}, Lcom/lge/ims/compat/TelephonyCompat;->startIsimStateMonitor()V'
+    if hook in s: return False
+    cs = s.index('.method public constructor <init>()V'); ce = s.index('.end method', cs)
+    body = s[cs:ce]
+    i = body.rindex('return-void')
+    body = body[:i] + hook + '\n\n    ' + body[i:]
+    s = s[:cs] + body + s[ce:]
+    open(f, 'w').write(s); return True
+
