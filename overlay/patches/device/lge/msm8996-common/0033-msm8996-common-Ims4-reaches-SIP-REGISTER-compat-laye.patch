diff --git a/ims/compat-java/com/android/internal/telephony/IIMSPhone.java b/ims/compat-java/com/android/internal/telephony/IIMSPhone.java
new file mode 100644
index 00000000..4694fb4d
--- /dev/null
+++ b/ims/compat-java/com/android/internal/telephony/IIMSPhone.java
@@ -0,0 +1,14 @@
+package com.android.internal.telephony;
+
+/**
+ * COMPILE-TIME STUB ONLY. The runtime class is extra-smali/com/android/internal/telephony/IIMSPhone.smali
+ * (the LG telephony-common AIDL interface Ims4 was built against); build-ims4.sh merges only
+ * com/lge/ims/compat/ out of the compat dex, so this file never reaches the apk. It exists so
+ * ImsPhoneCompat can `implements IIMSPhone` with the exact descriptor smali's invoke-interface uses.
+ */
+public interface IIMSPhone extends android.os.IInterface {
+    String[] getSysInfo(int item, int param, String paramEx) throws android.os.RemoteException;
+    void setImsStatusToModem(int a, int b, int c, int d) throws android.os.RemoteException;
+    void setListener(ISysMonitor listener) throws android.os.RemoteException;
+    void setSysInfo(int item, int param, int value, String paramEx) throws android.os.RemoteException;
+}
