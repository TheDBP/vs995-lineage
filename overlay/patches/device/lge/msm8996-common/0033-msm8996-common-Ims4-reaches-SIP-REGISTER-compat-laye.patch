diff --git a/ims/compat-java/com/lge/ims/compat/ImsPhoneCompat.java b/ims/compat-java/com/lge/ims/compat/ImsPhoneCompat.java
new file mode 100644
index 00000000..f52312e0
--- /dev/null
+++ b/ims/compat-java/com/lge/ims/compat/ImsPhoneCompat.java
@@ -0,0 +1,207 @@
+package com.lge.ims.compat;
+
+import android.content.Context;
+import android.content.Intent;
+import android.os.Handler;
+import android.os.IBinder;
+import android.os.Looper;
+import android.telephony.AccessNetworkConstants;
+import android.telephony.CellInfo;
+import android.telephony.CellSignalStrength;
+import android.telephony.NetworkRegistrationInfo;
+import android.telephony.ServiceState;
+import android.telephony.SignalStrength;
+import android.telephony.TelephonyCallback;
+import android.telephony.TelephonyManager;
+import android.telephony.VopsSupportInfo;
+import android.util.Log;
+
+import java.util.List;
+
+import com.android.internal.telephony.IIMSPhone;
+import com.android.internal.telephony.ISysMonitor;
+
+/**
+ * In-process stand-in for LG's `com.lge.ims.phone` binder service (IMSPhone in the stock
+ * telephony-common.jar), which does not exist on an AOSP framework. IIMSPhoneGov.bindIMSPhone() does
+ * `IIMSPhone.Stub.asInterface(ServiceManager.getService("com.lge.ims.phone"))`; method-redirects.txt
+ * points that asInterface at {@link #asInterface}, so Ims4 gets this object and never sees a null
+ * phone. Everything it asks for is answered from the public/system TelephonyManager API instead of
+ * LG's Phone extensions.
+ *
+ * getSysInfo items (stock IMSPhone.getSysInfo switch; return shapes preserved):
+ *   0x1  modem string item 0x6003e (LTE RF quality)  -> "FAILURE"  (no LG RIL item; result would
+ *        arrive via onPhoneStateChanged(6), which nothing here produces)
+ *   0x3  Phone.getLteInfo()/getCdmaInfo() String[]   -> null       (stock answer with no Phone)
+ *   0x7  raw ICC EF read (PSI/SMSC, async)           -> "FAILURE"  (SMS stays on CS; Flash B)
+ *   0x8  LTE network feature flags, param 1 emergency / param 2 voice over PS -> "1"/"0" from
+ *        NetworkRegistrationInfo(PS, WWAN).getDataSpecificInfo().getVopsSupportInfo(). THIS is the
+ *        VoPS answer BootupGov.notifyVOPSState() feeds AoS (IMS_EVENT_IMS_VOICE_OVER_PS_STATE); with
+ *        it false AoSServiceAvailableCellular keeps NONETWORK+VOPS and aos_app_0 sits OUTOFSERVICE.
+ *   0x9  active APN host                             -> null
+ *   0xf  call state 0 idle / 1 ringing / 2 offhook   -> TelephonyManager.getCallState() (same codes)
+ *   0x15 signal dBm                                  -> SignalStrength.getDbm()
+ *   0x19 ISIM state                                  -> TelephonyCompat.getIsimStateFromPhone()
+ *   0x1c/0x1e FDN enabled/available                  -> "FALSE";  0x22 FDN list -> null
+ *   0x65 {sysMode, imsPrefState}                     -> {"0","0"}
+ * setSysInfo / setImsStatusToModem are the modem-facing side (RIL_REQUEST_SET_MODEM_INFO etc., see
+ * IMS.md "How registration state reaches the modem"); logged and dropped here -- Flash B.
+ *
+ * VoPS is also pushed, not just polled: BootupGov asks item 8 at most twice, 1 s apart, right after
+ * the IMS PDN comes up, and the framework still says NOT_SUPPORTED then (it flips to SUPPORTED ~25 s
+ * after boot). Stock gets the later update from LG's RIL broadcasting
+ * lge.intent.action.LTE_NETWORK_SUPPORTED_INFO (int extras VoPS_Support / EPDN_Support, codes of
+ * LGDataPhoneConstants$VolteAndEPDNSupport) which DCNetWatcher turns into isVOPSUpdated/isVoPS and
+ * notifyEvent(IMS_EVENT_IMS_VOICE_OVER_PS_STATE). {@link #startVopsMonitor} replays that from a
+ * TelephonyCallback.ServiceStateListener: sticky (DCNetWatcher registers its filter after we are
+ * bound) and re-sent on every change.
+ */
+public final class ImsPhoneCompat implements IIMSPhone {
+    private static final String TAG = "ImsPhoneCompat";
+    private static final ImsPhoneCompat INSTANCE = new ImsPhoneCompat();
+    private volatile ISysMonitor mListener;
+
+    private static final String ACTION_LTE_NETWORK_SUPPORTED_INFO = "lge.intent.action.LTE_NETWORK_SUPPORTED_INFO";
+    // LGDataPhoneConstants$VolteAndEPDNSupport codes
+    private static final int VOLTE_NOT_SUPPORT = 1, VOLTE_SUPPORT = 2, EPDN_NOT_SUPPORT = 3, EPDN_SUPPORT = 4;
+    private static boolean sVopsMonitorStarted;
+    // TelephonyRegistryManager only weak-references a TelephonyCallback: an unreferenced listener is
+    // GC'd and the callbacks silently stop (first attempt lost the VoPS 3->2 flip 25 s after boot).
+    private static VopsListener sVopsListener;
+    private static int sSentVops = -1, sSentEpdn = -1;
+
+    private ImsPhoneCompat() {}
+
+    // IIMSPhone.Stub.asInterface(IBinder) -> this. The binder is always null here (no such service).
+    public static IIMSPhone asInterface(IBinder binder) {
+        if (binder != null) Log.w(TAG, "a real com.lge.ims.phone service exists; still using the in-process stand-in");
+        return INSTANCE;
+    }
+
+    @Override public IBinder asBinder() { return null; }
+
+    @Override public void setListener(ISysMonitor listener) {
+        mListener = listener;
+        Log.i(TAG, "setListener " + (listener != null));
+        if (listener != null) startVopsMonitor();
+    }
+
+    // Broadcast LTE_NETWORK_SUPPORTED_INFO like LG's RIL does, from the framework's VopsSupportInfo.
+    private static synchronized void startVopsMonitor() {
+        if (sVopsMonitorStarted) return;
+        TelephonyManager tm = tm();
+        if (tm == null) { Log.w(TAG, "startVopsMonitor: no TelephonyManager yet"); return; }
+        sVopsMonitorStarted = true;
+        Handler h = new Handler(Looper.getMainLooper());
+        sVopsListener = new VopsListener();
+        tm.registerTelephonyCallback(h::post, sVopsListener);
+        h.post(ImsPhoneCompat::publishVops);
+        Log.i(TAG, "startVopsMonitor");
+    }
+
+    private static final class VopsListener extends TelephonyCallback implements TelephonyCallback.ServiceStateListener {
+        @Override public void onServiceStateChanged(ServiceState ss) {
+            NetworkRegistrationInfo nri = ss.getNetworkRegistrationInfo(
+                    NetworkRegistrationInfo.DOMAIN_PS, AccessNetworkConstants.TRANSPORT_TYPE_WWAN);
+            VopsSupportInfo vi = nri == null || nri.getDataSpecificInfo() == null ? null : nri.getDataSpecificInfo().getVopsSupportInfo();
+            Log.d(TAG, "onServiceStateChanged: raw " + vi + " -> vops=" + vops(false) + " emc=" + vops(true));
+            publishVops();
+        }
+    }
+
+    private static void publishVops() {
+        Context ctx = TelephonyCompat.currentApplication();
+        if (ctx == null) return;
+        int vops = vops(false) ? VOLTE_SUPPORT : VOLTE_NOT_SUPPORT;
+        int epdn = vops(true) ? EPDN_SUPPORT : EPDN_NOT_SUPPORT;
+        if (vops == sSentVops && epdn == sSentEpdn) return;
+        Log.i(TAG, "VoPS_Support " + sSentVops + " -> " + vops + ", EPDN_Support " + sSentEpdn + " -> " + epdn + "; sticky " + ACTION_LTE_NETWORK_SUPPORTED_INFO);
+        sSentVops = vops; sSentEpdn = epdn;
+        Intent i = new Intent(ACTION_LTE_NETWORK_SUPPORTED_INFO).putExtra("VoPS_Support", vops).putExtra("EPDN_Support", epdn);
+        try {
+            ctx.sendStickyBroadcast(i);   // android.uid.phone carries BROADCAST_STICKY
+        } catch (SecurityException e) {
+            Log.w(TAG, "sendStickyBroadcast: " + e + "; plain broadcast");
+            ctx.sendBroadcast(i);
+        }
+    }
+
+    @Override public void setSysInfo(int item, int param, int value, String paramEx) {
+        Log.i(TAG, "setSysInfo(item=0x" + Integer.toHexString(item) + ", param=0x" + Integer.toHexString(param)
+                + ", value=" + value + ") dropped (no LG RIL)");
+    }
+
+    @Override public void setImsStatusToModem(int a, int b, int c, int d) {
+        Log.i(TAG, "setImsStatusToModem(" + a + "," + b + "," + c + "," + d + ") dropped (no LG RIL)");
+    }
+
+    @Override public String[] getSysInfo(int item, int param, String paramEx) {
+        switch (item) {
+            case 0x1: case 0x7:
+                return new String[] { "FAILURE" };
+            case 0x8: {
+                boolean v = param == 1 ? vops(true) : param == 2 ? vops(false) : false;
+                Log.d(TAG, "LTE network feature :: param(" + param + "), result(" + (v ? 1 : 0) + ")");
+                return new String[] { v ? "1" : "0" };
+            }
+            case 0xf: {
+                TelephonyManager tm = tm();
+                return new String[] { String.valueOf(tm == null ? 0 : tm.getCallState()) };
+            }
+            case 0x15: {
+                TelephonyManager tm = tm();
+                SignalStrength ss = tm == null ? null : tm.getSignalStrength();
+                // SignalStrength.getDbm() is @hide; the primary cell's CellSignalStrength is the public form
+                List<CellSignalStrength> cs = ss == null ? null : ss.getCellSignalStrengths();
+                int dbm = cs == null || cs.isEmpty() ? CellInfo.UNAVAILABLE : cs.get(0).getDbm();
+                return new String[] { String.valueOf(dbm) };
+            }
+            case 0x19:
+                return new String[] { TelephonyCompat.getIsimStateFromPhone(param) };
+            case 0x1c: case 0x1e:
+                return new String[] { "FALSE" };
+            case 0x65:
+                return new String[] { "0", "0" };
+            case 0x2: case 0x3: case 0x9: case 0x22:
+                return null;
+            default:
+                Log.d(TAG, "Unknown item (" + item + ")");
+                return null;
+        }
+    }
+
+    // LTE VoPS / emergency-bearer support for the PS domain on the cellular transport.
+    //
+    // LATCHED while PS stays registered on LTE: this device's qcrild reports lteVopsInfo.isVopsSupported
+    // only in DATA_REGISTRATION_STATE responses with rat=14 (LTE); every rat=19 (LTE_CA) response says
+    // false, and the RAT flips 14<->19 about once a second around data activity, so the framework's
+    // VopsSupportInfo flickers 2/3/2/3 on a cell whose Attach Accept said VoPS (VoPS is per tracking
+    // area; it cannot change without a TAU). Without the latch Ims4 is told VoPS=false right after
+    // SendREGISTER and tears registration down. Reset when PS leaves LTE or deregisters.
+    private static boolean sVopsLatched, sEmcLatched;
+
+    private static boolean vops(boolean emergency) {
+        try {
+            TelephonyManager tm = tm();
+            ServiceState ss = tm == null ? null : tm.getServiceState();
+            NetworkRegistrationInfo nri = ss == null ? null : ss.getNetworkRegistrationInfo(
+                    NetworkRegistrationInfo.DOMAIN_PS, AccessNetworkConstants.TRANSPORT_TYPE_WWAN);
+            boolean onLte = nri != null && nri.isRegistered()
+                    && nri.getAccessNetworkTechnology() == TelephonyManager.NETWORK_TYPE_LTE;
+            if (!onLte) { sVopsLatched = sEmcLatched = false; return false; }
+            VopsSupportInfo vi = nri.getDataSpecificInfo() == null ? null : nri.getDataSpecificInfo().getVopsSupportInfo();
+            if (vi == null) { Log.d(TAG, "vops: no VopsSupportInfo"); return emergency ? sEmcLatched : sVopsLatched; }
+            if (vi.isVopsSupported()) sVopsLatched = true;
+            if (vi.isEmergencyServiceSupported()) sEmcLatched = true;
+            return emergency ? sEmcLatched : sVopsLatched;
+        } catch (Exception e) {
+            Log.e(TAG, "vops: " + e);
+            return false;
+        }
+    }
+
+    private static TelephonyManager tm() {
+        Context ctx = TelephonyCompat.currentApplication();
+        return ctx == null ? null : ctx.getSystemService(TelephonyManager.class);
+    }
+}
diff --git a/ims/compat-java/com/lge/ims/compat/TelephonyCompat.java b/ims/compat-java/com/lge/ims/compat/TelephonyCompat.java
new file mode 100644
index 00000000..fbb71c4e
--- /dev/null
+++ b/ims/compat-java/com/lge/ims/compat/TelephonyCompat.java
@@ -0,0 +1,207 @@
+package com.lge.ims.compat;
+
+import android.content.ContentResolver;
+import android.content.Context;
+import android.content.Intent;
+import android.location.LocationManager;
+import android.net.ConnectivityManager;
+import android.net.LinkProperties;
+import android.net.Network;
+import android.net.NetworkCapabilities;
+import android.os.Handler;
+import android.os.Looper;
+import android.telephony.SubscriptionManager;
+import android.telephony.TelephonyManager;
+import android.text.TextUtils;
+import android.util.Log;
+
+import java.net.InetAddress;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Replacements for @hide TelephonyManager methods LG's 2016 Ims4 calls that no longer exist.
+ * Static; the first parameter is the receiver, so a smali `invoke-virtual {tm, ...}, TelephonyManager->m`
+ * becomes `invoke-static {tm, ...}, TelephonyCompat->m` with the registers untouched
+ * (method-redirects.txt `old|static new`).
+ *
+ * getPcscfAddress(apnType) returned the P-CSCF addresses the modem delivered in the PDN's PCO
+ * (Oreo: DcTracker -> DataConnection.getPcscfAddresses). Since Q they are on the IMS network's
+ * LinkProperties (getPcscfServers(), @SystemApi) -- find the network carrying NET_CAPABILITY_IMS
+ * (apnType "emergency" -> EIMS) and read them from there. null when no such network is up, which
+ * is what the old API returned before the PDN connected; DCApn.getValidAddresses() handles null.
+ *
+ * getIsimStateFromPhone(phoneId) replaces SIMStateAgent's own static of that name, which asked LG's
+ * `com.lge.ims.phone` binder service (IMSPhone in LG telephony-common, absent here) for item 0x19 ==
+ * LGImsIsimHandler.getIsimState(): "LOADED" once UiccController's APPTYPE_ISIM records are in, else
+ * "NOT_READY"/"NOT_PRESENT". Without it the ISIM is "disabled on INIT", the IMPI stays
+ * anonymous@anonymous.invalid and AoS blocks registration with SUBSCRIBERINCOMPLETED forever.
+ * Derived here from TelephonyManager: ISIM records loaded <=> IMPI readable. If the records are
+ * not in yet, a monitor polls and delivers the result the way stock does -- the sticky
+ * `com.lge.ims.ISIM_STATE_CHANGED` broadcast with `isimState`/`subscription`/`phone`, which
+ * SIMStateAgent already consumes (live receiver + sticky read-back).
+ *
+ * getIsim*ForSubscriber / getIsimChallengeResponse: LG per-subscriber ISIM getters and the pre-O
+ * challenge API. The modern equivalents are createForSubscriptionId(subId).getIsim*() and
+ * getIccAuthentication(APPTYPE_ISIM, AUTHTYPE_EAP_AKA, nonce) -- the latter is exactly what Ims4's
+ * own MTK branch of ISIMAgent.getChallengeResponse() calls, so the nonce/response encoding matches.
+ *
+ * isLocationProviderEnabledForUser: Settings.Secure's @hide helper is gone (location is no longer a
+ * Settings string); LocationManager.isProviderEnabled() is the per-current-user answer, which is what
+ * the userId -2 (USER_CURRENT) call sites asked for.
+ */
+public final class TelephonyCompat {
+    private static final String TAG = "TelephonyCompat";
+    private TelephonyCompat() {}
+
+    public static String[] getPcscfAddress(TelephonyManager tm, String apnType) {
+        return getPcscfAddressForSubscriber(tm, apnType, -1);
+    }
+
+    public static String[] getPcscfAddressForSubscriber(TelephonyManager tm, String apnType, int subId) {
+        Context ctx = currentApplication();
+        if (ctx == null) { Log.e(TAG, "no application context"); return null; }
+        ConnectivityManager cm = (ConnectivityManager) ctx.getSystemService(Context.CONNECTIVITY_SERVICE);
+        if (cm == null) return null;
+        int cap = "emergency".equals(apnType) ? NetworkCapabilities.NET_CAPABILITY_EIMS
+                                              : NetworkCapabilities.NET_CAPABILITY_IMS;
+        for (Network n : cm.getAllNetworks()) {
+            NetworkCapabilities nc = cm.getNetworkCapabilities(n);
+            if (nc == null || !nc.hasCapability(cap) || !nc.hasTransport(NetworkCapabilities.TRANSPORT_CELLULAR)) continue;
+            LinkProperties lp = cm.getLinkProperties(n);
+            if (lp == null) continue;
+            List<String> out = new ArrayList<>();
+            for (InetAddress a : lp.getPcscfServers()) out.add(a.getHostAddress());
+            Log.i(TAG, "getPcscfAddress(" + apnType + ") from " + n + " " + lp.getInterfaceName() + ": " + out);
+            return out.isEmpty() ? null : out.toArray(new String[0]);
+        }
+        Log.w(TAG, "getPcscfAddress(" + apnType + "): no network with capability " + cap);
+        return null;
+    }
+
+    // ---- ISIM state (stands in for LGImsIsimHandler + IIMSPhone.getSysInfo(0x19)) ----
+    // Stock SIMStateAgent learns the ISIM state two ways, both from LG telephony-common: the STICKY
+    // com.lge.ims.ISIM_STATE_CHANGED intent LGImsIsimHandler publishes (read back 5 s after the SIM
+    // goes LOADED, see updateIsimState) and IIMSPhone.getSysInfo(0x19) (data-subscription change
+    // only). Neither exists here, so SIMStateAgent.<init> starts this monitor (smali-fixups.py): poll
+    // until the ISIM records are readable, then publish the same sticky intent with the same extras.
+    private static final String ACTION_ISIM_STATE_CHANGED = "com.lge.ims.ISIM_STATE_CHANGED";
+    private static final int ISIM_POLL_FAST_MS = 1000, ISIM_POLL_FAST_MAX = 180, ISIM_POLL_SLOW_MS = 10000;
+    private static Handler sHandler;
+    private static boolean sMonitorStarted;
+    private static String sPublished;
+    private static int sPolls;
+
+    public static synchronized void startIsimStateMonitor() {
+        if (sMonitorStarted) return;
+        sMonitorStarted = true;
+        Log.i(TAG, "startIsimStateMonitor");
+        handler().post(TelephonyCompat::isimPoll);
+    }
+
+    private static synchronized Handler handler() {
+        if (sHandler == null) sHandler = new Handler(Looper.getMainLooper());
+        return sHandler;
+    }
+
+    private static void isimPoll() {
+        final int phoneId = 0;   // single-SIM device; LGImsIsimHandler tracks phone 0 the same way
+        String state = computeIsimState(phoneId);
+        sPolls++;
+        if (!"NOT_READY".equals(state) && !state.equals(sPublished)) {
+            publishIsimState(state, phoneId);
+        } else if ("NOT_READY".equals(state) && sPublished != null && !"NOT_READY".equals(sPublished)) {
+            publishIsimState(state, phoneId);   // SIM pulled / refreshing: tell SIMStateAgent too
+        }
+        boolean fast = sPublished == null && sPolls < ISIM_POLL_FAST_MAX;
+        handler().postDelayed(TelephonyCompat::isimPoll, fast ? ISIM_POLL_FAST_MS : ISIM_POLL_SLOW_MS);
+    }
+
+    private static void publishIsimState(String state, int phoneId) {
+        Context ctx = currentApplication();
+        if (ctx == null) return;
+        int subId = SubscriptionManager.getSubscriptionId(phoneId);
+        Intent i = new Intent(ACTION_ISIM_STATE_CHANGED)
+                .putExtra("isimState", state).putExtra("subscription", subId).putExtra("phone", phoneId);
+        Log.i(TAG, "ISIM state " + sPublished + " -> " + state + " (poll " + sPolls + ", subId " + subId + "); sticky broadcast");
+        sPublished = state;
+        try {
+            ctx.sendStickyBroadcast(i);   // android.uid.phone carries BROADCAST_STICKY
+        } catch (SecurityException e) {
+            Log.w(TAG, "sendStickyBroadcast: " + e + "; plain broadcast");
+            ctx.sendBroadcast(i);
+        }
+    }
+
+    public static String getIsimStateFromPhone(int phoneId) {
+        String state = computeIsimState(phoneId);
+        Log.i(TAG, "getIsimStateFromPhone(" + phoneId + ") = " + state);
+        startIsimStateMonitor();
+        return state;
+    }
+
+    private static String computeIsimState(int phoneId) {
+        Context ctx = currentApplication();
+        if (ctx == null) return "NOT_READY";
+        TelephonyManager tm = ctx.getSystemService(TelephonyManager.class);
+        if (tm == null) return "NOT_READY";
+        int simState = tm.getSimState(phoneId);
+        if (simState == TelephonyManager.SIM_STATE_ABSENT
+                || (simState == TelephonyManager.SIM_STATE_UNKNOWN && !tm.hasIccCard())) return "NOT_PRESENT";
+        int subId = SubscriptionManager.getSubscriptionId(phoneId);
+        if (!SubscriptionManager.isValidSubscriptionId(subId)) return "NOT_READY";
+        String impi = (String) hidden(tm.createForSubscriptionId(subId), "getIsimImpi");
+        return TextUtils.isEmpty(impi) ? "NOT_READY" : "LOADED";
+    }
+
+    // ---- LG per-subscriber ISIM getters + pre-O challenge API ----
+    private static TelephonyManager forSub(TelephonyManager tm, int subId) {
+        return SubscriptionManager.isValidSubscriptionId(subId) ? tm.createForSubscriptionId(subId) : tm;
+    }
+    public static String getIsimImpiForSubscriber(TelephonyManager tm, int subId) { return (String) hidden(forSub(tm, subId), "getIsimImpi"); }
+    public static String getIsimDomainForSubscriber(TelephonyManager tm, int subId) { return forSub(tm, subId).getIsimDomain(); }
+    public static String[] getIsimImpuForSubscriber(TelephonyManager tm, int subId) { return (String[]) hidden(forSub(tm, subId), "getIsimImpu"); }
+    public static String getIsimIstForSubscriber(TelephonyManager tm, int subId) { return forSub(tm, subId).getIsimIst(); }
+    public static String[] getIsimPcscfForSubscriber(TelephonyManager tm, int subId) { return (String[]) hidden(forSub(tm, subId), "getIsimPcscf"); }
+    public static String getIsimChallengeResponse(TelephonyManager tm, String nonce) {
+        String r = tm.getIccAuthentication(TelephonyManager.APPTYPE_ISIM, TelephonyManager.AUTHTYPE_EAP_AKA, nonce);
+        Log.i(TAG, "getIsimChallengeResponse: " + (r == null ? "null" : r.length() + " chars"));
+        return r;
+    }
+    public static String getIsimChallengeResponseForSubscriber(TelephonyManager tm, String nonce, int subId) {
+        return getIsimChallengeResponse(forSub(tm, subId), nonce);
+    }
+
+    // @hide (non-SystemApi) TelephonyManager getters: no stub in the system android.jar -> reflection.
+    private static Object hidden(TelephonyManager tm, String method) {
+        try {
+            return TelephonyManager.class.getMethod(method).invoke(tm);
+        } catch (Exception e) {
+            Log.e(TAG, method + ": " + e);
+            return null;
+        }
+    }
+
+    // Settings.Secure.isLocationProviderEnabledForUser(resolver, provider, userId) -> LocationManager.
+    public static boolean isLocationProviderEnabledForUser(ContentResolver cr, String provider, int userId) {
+        Context ctx = currentApplication();
+        LocationManager lm = ctx == null ? null : ctx.getSystemService(LocationManager.class);
+        try {
+            return lm != null && lm.isProviderEnabled(provider);
+        } catch (Exception e) {
+            Log.e(TAG, "isProviderEnabled(" + provider + "): " + e);
+            return false;
+        }
+    }
+
+    // android.app.ActivityThread.currentApplication() is @hide; Ims4 is platform-signed so the call is
+    // allowed, but android.jar has no stub for it -> reflection.
+    static Context currentApplication() {
+        try {
+            return (Context) Class.forName("android.app.ActivityThread").getMethod("currentApplication").invoke(null);
+        } catch (Exception e) {
+            Log.e(TAG, "currentApplication: " + e);
+            return null;
+        }
+    }
+}
