From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheDBP <TheDBP@users.noreply.github.com>
Date: Sat, 10 Oct 2026 08:26:15 -0400
Subject: [PATCH] msm8996-common: ims: fail the build when Ims4-reworked.apk is
 older than its sources

Ims4-reworked.apk is produced by ims/build-ims4.sh and gitignored, and
ims/Android.bp installs it with android_app_import, so a normal build never
regenerates it. An edit under ims/extra-smali, ims/compat-java or
ims/legacy-java therefore applies cleanly as a patch, compiles green and
ships nothing at all.

That is not hypothetical. The carrier derivation folded into patch 0028
was written, patched, built and flashed, and the device kept running the
old hardcoded stub because nobody reran the script. It took decompiling
the shipped apk to notice.

sources-hash.sh hashes the inputs that decide the output. build-ims4.sh
writes that hash beside the apk, and ims.mk recomputes it at product config
time and stops the build on a mismatch, naming the script to rerun.
IMS4_ALLOW_STALE=1 ships the apk as it is.

One script computes the hash for both writer and checker, because two
copies of the definition would drift and the guard would start lying.

Verified all three paths before committing: a corrupted stamp stops the
parse with the remedy, a correct stamp parses, and the escape hatch parses
while stale.
---
 ims/.gitignore      |  2 ++
 ims/build-ims4.sh   |  6 ++++++
 ims/ims.mk          | 17 +++++++++++++++++
 ims/sources-hash.sh | 23 +++++++++++++++++++++++
 4 files changed, 48 insertions(+)
 create mode 100755 ims/sources-hash.sh

diff --git a/ims/.gitignore b/ims/.gitignore
index 965f3296..0dc2b9fe 100644
--- a/ims/.gitignore
+++ b/ims/.gitignore
@@ -1,6 +1,8 @@
 # Proprietary-derived + intermediates -- produced by build-ims4.sh, never committed.
 .work/
 Ims4-reworked.apk
+# Describes the local apk above, so it is local too. ims.mk compares it to sources-hash.sh.
+.sources.sha256
 .push-sysapp/
 ipsecstarter
 ipsecclient
diff --git a/ims/build-ims4.sh b/ims/build-ims4.sh
index 063baf8b..d36d6065 100755
--- a/ims/build-ims4.sh
+++ b/ims/build-ims4.sh
@@ -162,6 +162,12 @@ cp "$APK" "$OUT"
 zip -q -d "$OUT" 'META-INF/*' >/dev/null 2>&1 || true
 echo ">> built $OUT ($(stat -c %s "$OUT") bytes, $(unzip -l "$OUT" | grep -c 'lib/armeabi-v7a/.*\.so') libs bundled) -- unsigned, for android_app_import certificate:platform"
 
+# Record what this apk was built from, beside the apk. ims.mk refuses to build when this does not
+# match the sources, because a normal build only installs the apk and would otherwise ship an old
+# one while the edited sources sit there looking applied.
+"$HERE/sources-hash.sh" > "$HERE/.sources.sha256"
+echo "   recorded source hash $(cut -c1-16 < "$HERE/.sources.sha256")... in ims/.sources.sha256"
+
 echo ">> 7. stage the IPsec helpers (stock 32-bit /system/bin, uncommitted; ims/Android.bp cc_prebuilt_binary)"
 # libims installs the REGISTER security agreement's ESP SAs through LG's ipsecstarter -> ipsecclient
 # (netlink xfrm), not by itself; without them registration dies at "add policy is failed".
diff --git a/ims/ims.mk b/ims/ims.mk
index 49f85ccc..b3560e91 100644
--- a/ims/ims.mk
+++ b/ims/ims.mk
@@ -5,6 +5,23 @@
 # lib/armeabi-v7a/ -- that forces the com.lge.ims process 32-bit on zygote64_32 and loads the libs from
 # the app namespace's own path. No LG libs in /system/lib; only the framework libs they pull (and
 # libimscompat) are public (system/core patch to public.libraries.android.txt).
+# Ims4-reworked.apk is produced by ims/build-ims4.sh and is NOT regenerated by a normal build:
+# ims/Android.bp installs it with android_app_import. So an edit under ims/extra-smali, ims/
+# compat-java or ims/legacy-java applies cleanly as a patch, builds green, and ships nothing, which
+# has already cost one full build and flash. Compare what the apk was built from against what is on
+# disk and stop early if they differ. IMS4_ALLOW_STALE=1 skips the check.
+ifneq ($(IMS4_ALLOW_STALE),1)
+  forge_ims4_apk := $(LOCAL_PATH)/ims/Ims4-reworked.apk
+  ifneq ($(wildcard $(forge_ims4_apk)),)
+    forge_ims4_want := $(shell $(LOCAL_PATH)/ims/sources-hash.sh 2>/dev/null)
+    forge_ims4_have := $(shell cat $(LOCAL_PATH)/ims/.sources.sha256 2>/dev/null)
+    ifneq ($(forge_ims4_want),$(forge_ims4_have))
+      $(warning Ims4-reworked.apk is stale: built from $(if $(forge_ims4_have),$(forge_ims4_have),no recorded hash), sources now $(forge_ims4_want))
+      $(error Rerun device/lge/msm8996-common/ims/build-ims4.sh against the stock firmware, or set IMS4_ALLOW_STALE=1 to ship the apk as it is)
+    endif
+  endif
+endif
+
 PRODUCT_PACKAGES += \
     libimscompat \
     Ims4
diff --git a/ims/sources-hash.sh b/ims/sources-hash.sh
new file mode 100755
index 00000000..b79786a8
--- /dev/null
+++ b/ims/sources-hash.sh
@@ -0,0 +1,23 @@
+#!/usr/bin/env bash
+# sources-hash.sh -- hash the inputs that decide what build-ims4.sh produces.
+#
+# Ims4-reworked.apk is a gitignored artifact that a normal build only installs, never regenerates.
+# Editing anything below therefore changes nothing until build-ims4.sh is rerun, and the build still
+# succeeds, so the edit silently does not ship. build-ims4.sh records this hash beside the apk and
+# ims.mk compares it, which turns that silence into a build failure.
+#
+# Both the writer and the checker call this one script on purpose: two copies of the definition
+# would drift and the guard would start lying.
+set -euo pipefail
+HERE="$(cd "$(dirname "$0")" && pwd)"
+cd "$HERE"
+
+# Sorted for determinism; missing entries are skipped so this stays usable on other devices.
+{
+  for p in extra-smali compat-java legacy-java; do
+    [ -d "$p" ] && find "$p" -type f | LC_ALL=C sort | xargs -r cat
+  done
+  for f in smali-fixups.py method-redirects.txt iface-list.txt build-ims4.sh; do
+    [ -f "$f" ] && cat "$f"
+  done
+} | sha256sum | cut -d' ' -f1
