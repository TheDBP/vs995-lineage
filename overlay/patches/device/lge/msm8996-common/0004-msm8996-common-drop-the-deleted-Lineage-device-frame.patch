From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheDBP <TheDBP@users.noreply.github.com>
Date: Wed, 30 Sep 2026 17:35:03 -0400
Subject: [PATCH] msm8996-common: drop the deleted Lineage device framework
 matrix path

vendor/lineage/config/device_framework_matrix.xml does not exist on 24.0.
Its content is now hardware/lineage/interfaces/compatibility_matrices as a
vintf_compatibility_matrix module, and vendor/lineage/config/common.mk
already puts framework_compatibility_matrix.lineage.xml in every product,
so naming the old path only breaks the build:

  module "framework_compatibility_matrix.device.xml" variant
  "android_common": source path
  "vendor/lineage/config/device_framework_matrix.xml" does not exist

---
 BoardConfigCommon.mk | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/BoardConfigCommon.mk b/BoardConfigCommon.mk
index b5f2fcde..baec91bb 100644
--- a/BoardConfigCommon.mk
+++ b/BoardConfigCommon.mk
@@ -105,8 +105,7 @@ LOC_HIDL_VERSION := 3.0
 DEVICE_FRAMEWORK_COMPATIBILITY_MATRIX_FILE := \
     $(COMMON_PATH)/framework_compatibility_matrix.xml \
     hardware/qcom-caf/common/vendor_framework_compatibility_matrix.xml \
-    hardware/qcom-caf/common/vendor_framework_compatibility_matrix_legacy.xml \
-    vendor/lineage/config/device_framework_matrix.xml
+    hardware/qcom-caf/common/vendor_framework_compatibility_matrix_legacy.xml
 
 DEVICE_MANIFEST_FILE := $(COMMON_PATH)/manifest.xml
 DEVICE_MATRIX_FILE := $(COMMON_PATH)/compatibility_matrix.xml
