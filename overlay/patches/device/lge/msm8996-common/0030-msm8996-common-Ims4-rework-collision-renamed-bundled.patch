diff --git a/ims/smali-fixups.py b/ims/smali-fixups.py
new file mode 100644
index 00000000..4313822b
--- /dev/null
+++ b/ims/smali-fixups.py
@@ -0,0 +1,60 @@
+#!/usr/bin/env python3
+# smali-fixups.py <merged-smali-dir>
+# Structural smali edits to the reworked Ims4 app that cannot be expressed as a one-line
+# method-redirect (adding fields, splicing instructions). Each fixup is idempotent -- safe to re-run.
+# Keep these minimal and documented; prefer method-redirects.txt for pure symbol swaps.
+import os, sys
+
+def fix_phonestatelistener_subid(root):
+    # A17 removed android.telephony.PhoneStateListener(int subId); its package-private mSubId field went
+    # with it. LG's PhoneStateAgent$PhoneStateListenerEx read that inherited field (getSubId / line 299).
+    # We dropped the super(subId) call (see method-redirects.txt), so give the subclass its own mSubId
+    # and set it from the ctor's subId param, keeping getSubId() working.
+    f = os.path.join(root, 'com/lge/ims/common/agents/PhoneStateAgent$PhoneStateListenerEx.smali')
+    if not os.path.exists(f): return False
+    s = open(f).read()
+    if '->mSubId:I' not in s: return False
+    changed = False
+    if '.field private mSubId:I' not in s:
+        s = s.replace('.field final synthetic this$0:Lcom/lge/ims/common/agents/PhoneStateAgent;',
+                      '.field private mSubId:I\n\n.field final synthetic this$0:Lcom/lge/ims/common/agents/PhoneStateAgent;', 1)
+        changed = True
+    sup = 'invoke-direct {p0}, Landroid/telephony/PhoneStateListener;-><init>()V'
+    cs = s.index('.method public constructor <init>(Lcom/lge/ims/common/agents/PhoneStateAgent;I)V')
+    ce = s.index('.end method', cs)
+    ctor = s[cs:ce]
+    if 'mSubId:I' not in ctor.split(sup)[0] and sup in ctor:
+        ctor2 = ctor.replace(sup, sup + '\n\n    iput p2, p0, Lcom/lge/ims/common/agents/PhoneStateAgent$PhoneStateListenerEx;->mSubId:I', 1)
+        s = s[:cs] + ctor2 + s[ce:]; changed = True
+    if changed: open(f, 'w').write(s)
+    return changed
+
+
+def noop_telephony_registry_notify(root):
+    # A17 changed ITelephonyRegistry.notifyCallState(int,String) and removed notifyVoLteServiceStateChanged
+    # / android.telephony.VoLteServiceState. LG's TelephonyCallStateRegistry pushes IMS call-state into
+    # the framework via the 2016 signatures; the NoSuchMethodError is an Error (not caught by its
+    # try/catch Exception) so it aborts core-module load. No-op the push for Flash A (service registers);
+    # wire the A17 signature in Flash B. Replace the method body with "return true" (notify succeeded).
+    f = os.path.join(root, 'com/lge/ims/server/ims/telephony/TelephonyCallStateRegistry.smali')
+    if not os.path.exists(f): return False
+    s = open(f).read()
+    import re
+    sig = '.method private static notifyCallStateForTelephonyRegistry(Lcom/lge/ims/server/ims/telephony/TelephonyCallState;)Z'
+    i = s.find(sig)
+    if i < 0 or 'ITelephonyRegistry;->notifyCallState' not in s[i:s.find('.end method', i)]:
+        return False
+    end = s.find('.end method', i) + len('.end method')
+    body = (sig + '\n    .registers 7\n    .param p0, "callState"    # Lcom/lge/ims/server/ims/telephony/TelephonyCallState;\n'
+            '    const/4 v0, 0x1\n    return v0\n.end method')
+    s = s[:i] + body + s[end:]
+    open(f, 'w').write(s); return True
+
+def main():
+    root = sys.argv[1]
+    for name, fn in [('PhoneStateListenerEx.mSubId', fix_phonestatelistener_subid),
+                     ('TelephonyCallStateRegistry.notify', noop_telephony_registry_notify)]:
+        print(f'   smali-fixup {name}: {"applied" if fn(root) else "skip/already"}')
+
+if __name__ == '__main__':
+    main()
