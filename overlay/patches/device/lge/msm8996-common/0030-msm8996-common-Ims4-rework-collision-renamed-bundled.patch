diff --git a/ims/.gitignore b/ims/.gitignore
index 90998d16..4813e6f3 100644
--- a/ims/.gitignore
+++ b/ims/.gitignore
@@ -1,3 +1,4 @@
 # Proprietary-derived + intermediates -- produced by build-ims4.sh, never committed.
 .work/
 Ims4-reworked.apk
+.push-sysapp/
diff --git a/ims/build-ims4.sh b/ims/build-ims4.sh
index 19c1fa69..57f10dd7 100755
--- a/ims/build-ims4.sh
+++ b/ims/build-ims4.sh
@@ -25,7 +25,7 @@ set -euo pipefail
 APK="${1:?usage: build-ims4.sh <Ims4.apk> <boot-ims-common.oat> <system.image|bootcp> <framework-smali> <stock-libs-dir> <out.apk>}"
 IMSCOMMON="${2:?boot-ims-common.oat}"; BOOTCP="${3:?system.image or bootcp dir}"; FWSMALI="${4:?framework smali dir}"
 STOCKLIBS="${5:?stock-libs-dir (32-bit LG SIP + QMI libs)}"; OUT="${6:?out.apk}"
-LG_LIBS="libims libimsmmpf libimswms libext2_uuid libvss_ims_qcci libqmi libqmi_cci libqmi_common_so libqmi_encdec libqmi_client_qmux libqmiservices libidl libsmemlog libmdmdetect libdsutils"
+LG_LIBS="libims libimsmmpf libimswms libext2_uuid libvss_ims_qcci libdiag libssl libcrypto libjpeg libqmi libqmi_cci libqmi_common_so libqmi_encdec libqmi_client_qmux libqmiservices libidl libsmemlog libmdmdetect libdsutils"
 HERE="$(cd "$(dirname "$0")" && pwd)"
 FORGE="${FORGE:-$HERE/../../../../../forge}"; [ -d "$FORGE/tools" ] || FORGE="${FORGE_DIR:?set FORGE to the forge dir}"
 T="$HERE/.work"; rm -rf "$T"; mkdir -p "$T"
@@ -80,6 +80,10 @@ if [ -f "$HERE/method-redirects.txt" ]; then
   done < "$HERE/method-redirects.txt"
   echo "   redirects applied"
 fi
+if [ -f "$HERE/smali-fixups.py" ]; then
+  echo ">> 4.6 apply structural smali fixups"
+  python3 "$HERE/smali-fixups.py" "$T/merged"
+fi
 
 echo ">> 5. bundle the 32-bit LG libs into the apk (patchelf-fixed) -- forces 32-bit + app-namespace load"
 PE=""; for p in patchelf-0_18 patchelf-0_17_2 patchelf; do c="$S/prebuilts/extract-tools/linux-x86/bin/$p"; [ -x "$c" ] && PE="$c" && break; done
@@ -97,10 +101,25 @@ done
 "$PE" --add-needed libimscompat.so "$T/lib/armeabi-v7a/libimsmmpf.so"
 echo "   bundled $(ls "$T/lib/armeabi-v7a" | wc -l) libs, DT_NEEDED fixed"
 
+# Collision rename: a bundled lib whose name also exists in /system/lib (newer, incompatible ABI)
+# gets shadowed -- the app namespace finds the already-loaded SYSTEM copy first, and the 2016 symbols
+# (e.g. boringssl CBS_data in libssl->libcrypto) are missing. Rename every such bundled lib to a
+# private -lgeims soname + redirect all bundled libs' DT_NEEDED to it, so the 2016 pair stays matched.
+SYSLIB_DIR="$S/out/target/product/vs995/system/lib"
+for f in "$T"/lib/armeabi-v7a/*.so; do
+  b=$(basename "$f" .so)
+  if [ -f "$SYSLIB_DIR/$b.so" ]; then                      # name clashes with a system lib
+    "$PE" --set-soname "${b}_lgeims.so" "$f"
+    mv "$f" "$T/lib/armeabi-v7a/${b}_lgeims.so"
+    for g in "$T"/lib/armeabi-v7a/*.so; do "$PE" --replace-needed "$b.so" "${b}_lgeims.so" "$g" 2>/dev/null || true; done
+    echo "   collision-renamed $b.so -> ${b}_lgeims.so"
+  fi
+done
+
 echo ">> 6. assemble + repackage unsigned (dex + bundled libs)"
 [ -d "$HERE/extra-smali" ] && cp -r "$HERE/extra-smali/." "$T/merged/" && echo "   merged $(find "$HERE/extra-smali" -name "*.smali" | wc -l) extra LG-framework stub classes"
 java -jar "$SM" assemble "$T/merged" -o "$T/classes.dex"
 cp "$APK" "$OUT"
-(cd "$T" && zip -q "$OUT" classes.dex && zip -q -r "$OUT" lib)
+(cd "$T" && zip -q "$OUT" classes.dex && zip -q -0 -X -r "$OUT" lib)
 zip -q -d "$OUT" 'META-INF/*' >/dev/null 2>&1 || true
 echo ">> built $OUT ($(stat -c %s "$OUT") bytes, $(unzip -l "$OUT" | grep -c 'lib/armeabi-v7a/.*\.so') libs bundled) -- unsigned, for android_app_import certificate:platform"
diff --git a/ims/extra-smali/android/telephony/AvailableRatInfo.smali b/ims/extra-smali/android/telephony/AvailableRatInfo.smali
new file mode 100644
index 00000000..48e6b585
--- /dev/null
+++ b/ims/extra-smali/android/telephony/AvailableRatInfo.smali
@@ -0,0 +1,15 @@
+# A17 lacks LG's android.telephony.AvailableRatInfo (a RAT-availability data carrier pushed by LG's
+# telephony service, which does not exist on A17). The app only reads its apnType/rats fields from a
+# message that never arrives here, so a plain two-field class satisfies dex verification.
+.class public Landroid/telephony/AvailableRatInfo;
+.super Ljava/lang/Object;
+
+.field public apnType:Ljava/lang/String;
+
+.field public rats:[Ljava/lang/Integer;
+
+.method public constructor <init>()V
+    .registers 1
+    invoke-direct {p0}, Ljava/lang/Object;-><init>()V
+    return-void
+.end method
diff --git a/ims/extra-smali/android/telephony/TelephonyManagerEx.smali b/ims/extra-smali/android/telephony/TelephonyManagerEx.smali
new file mode 100644
index 00000000..e180f598
--- /dev/null
+++ b/ims/extra-smali/android/telephony/TelephonyManagerEx.smali
@@ -0,0 +1,32 @@
+# A17 lacks LG's android.telephony.TelephonyManagerEx. The app fetches it via getSystemService("phone")
+# + check-cast (which throws ClassCastException on A17's real TelephonyManager, caught by the app's own
+# try/catch) so these setters are never actually reached. No-op bodies satisfy verification; real modem
+# wiring (setCallType/setAccessNetwork/startHVoLteModeSelection) is a Flash B concern -- see IMS.md.
+.class public Landroid/telephony/TelephonyManagerEx;
+.super Ljava/lang/Object;
+
+.method public constructor <init>()V
+    .registers 1
+    invoke-direct {p0}, Ljava/lang/Object;-><init>()V
+    return-void
+.end method
+
+.method public setAccessNetwork(II)V
+    .registers 3
+    return-void
+.end method
+
+.method public setCallType(II)V
+    .registers 3
+    return-void
+.end method
+
+.method public setPreference(II)V
+    .registers 3
+    return-void
+.end method
+
+.method public startHVoLteModeSelection()V
+    .registers 1
+    return-void
+.end method
