diff --git a/ims/build-ims4.sh b/ims/build-ims4.sh
new file mode 100755
index 00000000..e8edd04c
--- /dev/null
+++ b/ims/build-ims4.sh
@@ -0,0 +1,96 @@
+#!/usr/bin/env bash
+# build-ims4.sh -- rework LG's stock Ims4 into a self-contained, platform-signable apk for Android 17.
+# Renames com.android.ims.* (removed since P, and incompatibly retained on A17) to com.lge.imslegacy.*
+# and merges that legacy API into Ims4's own dex. See ../../../../IMS.md "Build plan" and
+# rom-forge/docs/debugging-volte.md "Rework an OEM legacy IMS app".
+#
+#   build-ims4.sh <Ims4.apk> <boot-ims-common.oat> <system.image|bootcp-dir> <framework-smali-dir> \
+#                 <stock-libs-dir> <out.apk>
+#
+# Proprietary inputs (NOT committed -- stage them): the stock Ims4.apk, boot-ims-common.oat and a stock
+# system image (for the deodex boot classpath), a framework deodex that holds the com.android.ims AIDL
+# interfaces + parcelables (quickened is fine), and <stock-libs-dir> holding the 32-bit LG SIP libs +
+# QMI deps (the 15 in LG_LIBS below). Committed here: iface-list.txt and legacy-java/ (parcelable stubs).
+# Generic steps use the forge tools; set FORGE to the forge dir.
+#
+# The 15 LG libs are bundled INTO the apk under lib/armeabi-v7a/ (patchelf-fixed: libims/libimsmmpf get
+# add-needed libimscompat + the dead video DT_NEEDED removed). Bundling forces the com.lge.ims process
+# 32-bit on zygote64_32 AND puts the libs in the app namespace's own permitted path, so only the
+# framework libs (+ libimscompat) need public.libraries. libimscompat itself is a Soong cc_library in
+# /system/lib (public) -- the bundled libims resolves it from the shared system namespace.
+#
+# OUTPUT is UNSIGNED, no META-INF -> ship via android_app_import certificate:platform (Ims4 is
+# sharedUserId android.uid.phone, must be signed by the platform key).
+set -euo pipefail
+APK="${1:?usage: build-ims4.sh <Ims4.apk> <boot-ims-common.oat> <system.image|bootcp> <framework-smali> <stock-libs-dir> <out.apk>}"
+IMSCOMMON="${2:?boot-ims-common.oat}"; BOOTCP="${3:?system.image or bootcp dir}"; FWSMALI="${4:?framework smali dir}"
+STOCKLIBS="${5:?stock-libs-dir (32-bit LG SIP + QMI libs)}"; OUT="${6:?out.apk}"
+LG_LIBS="libims libimsmmpf libimswms libext2_uuid libvss_ims_qcci libqmi libqmi_cci libqmi_common_so libqmi_encdec libqmi_client_qmux libqmiservices libidl libsmemlog libmdmdetect libdsutils"
+HERE="$(cd "$(dirname "$0")" && pwd)"
+FORGE="${FORGE:-$HERE/../../../../../forge}"; [ -d "$FORGE/tools" ] || FORGE="${FORGE_DIR:?set FORGE to the forge dir}"
+T="$HERE/.work"; rm -rf "$T"; mkdir -p "$T"
+S="${BUILD_ROOT:-$(cd "$HERE/../../../../.." && pwd)/build_output}/src"
+AIDL="$S/prebuilts/build-tools/linux-x86/bin/aidl"
+JAVAC="$(for v in jdk21 jdk17 jdk11; do c="$S/prebuilts/jdk/$v/linux-x86/bin/javac"; [ -x "$c" ] && echo "$c" && break; done)"
+AJAR="$S/prebuilts/sdk/current/public/android.jar"
+R8="$S/prebuilts/r8/r8.jar"; BK="$S/prebuilts/extract-tools/common/smali/baksmali.jar"; SM="$S/prebuilts/extract-tools/common/smali/smali.jar"
+
+echo ">> 1. deodex Ims4.apk + boot-ims-common"
+"$FORGE/tools/oat-to-smali.sh" "$APK" "$T/smali-ims4" >/dev/null
+BUILD_ROOT="${BUILD_ROOT:-$(cd "$HERE/../../../../.." && pwd)/build_output}" "$FORGE/tools/deodex-jar.sh" "$IMSCOMMON" "$BOOTCP" "$T/smali-imscommon" >/dev/null
+
+echo ">> 2. regenerate the legacy AIDL interfaces -> clean smali"
+IFACES="$(tr '\n' ' ' < "$HERE/iface-list.txt") IImsExternalCallStateListener IImsVideoCallCallback"
+mkdir -p "$T/aidlgen/legacy"; ln -sf "$FWSMALI" "$T/aidlgen/legacy/framework2"
+LEGACY_PKG=com.lge.imslegacy python3 "$FORGE/tools/gen-legacy-aidl.py" "$T/aidlgen" "$T/aidl" $IFACES
+# parcelable .aidl decls + build-time stub java (one per legacy-java/ class)
+mkdir -p "$T/aidlroot/com/lge/imslegacy/internal"
+cp "$T"/aidl/*.aidl "$T/aidlroot/com/lge/imslegacy/" 2>/dev/null || true
+cp "$T"/aidl/internal/*.aidl "$T/aidlroot/com/lge/imslegacy/internal/" 2>/dev/null || true
+for j in "$HERE"/legacy-java/com/lge/imslegacy/*.java; do c=$(basename "$j" .java); printf 'package com.lge.imslegacy;\nparcelable %s;\n' "$c" > "$T/aidlroot/com/lge/imslegacy/$c.aidl"; done
+INCL="-I$T/aidlroot -I$S/frameworks/base/core/java -I$S/frameworks/base/telecomm/java -I$S/frameworks/base/telephony/java -I$S/frameworks/base/telecomm/framework/aidl-export -I$S/frameworks/native/aidl/gui"
+mkdir -p "$T/gen-java"; for a in $(find "$T/aidlroot" -name '*.aidl'); do grep -q '^interface' "$a" && "$AIDL" $INCL -o"$T/gen-java" "$a"; done
+mkdir -p "$T/classes"; find "$T/gen-java" "$HERE/legacy-java" -name '*.java' > "$T/srcs.txt"
+"$JAVAC" --release 17 -cp "$AJAR" -d "$T/classes" @"$T/srcs.txt"
+mkdir -p "$T/dex"; find "$T/classes" -name '*.class' > "$T/cls.txt"
+java -cp "$R8" com.android.tools.r8.D8 --min-api 21 --lib "$AJAR" --output "$T/dex" @"$T/cls.txt"
+java -jar "$BK" d "$T/dex/classes.dex" -o "$T/legacy-smali" >/dev/null
+
+echo ">> 3. unified legacy source (all com.android.ims) = deodexed logic + interfaces/stubs"
+mkdir -p "$T/legacy-final"; cp -r "$T/smali-imscommon/com" "$T/legacy-final/"
+cp -r "$T/legacy-smali" "$T/tmp2"
+find "$T/tmp2" -name '*.smali' -exec sed -i 's#Lcom/lge/imslegacy#Lcom/android/ims#g; s#com\.lge\.imslegacy#com.android.ims#g' {} +
+python3 -c "
+import os,shutil,sys
+b=sys.argv[1]+'/tmp2/com/lge/imslegacy'
+for dp,_,fns in os.walk(b):
+ for fn in fns:
+  if fn.endswith('.smali'):
+   src=os.path.join(dp,fn); rel=os.path.relpath(src,b); dst=os.path.join(sys.argv[1],'legacy-final/com/android/ims',rel)
+   os.makedirs(os.path.dirname(dst),exist_ok=True); shutil.copy(src,dst)" "$T"
+
+echo ">> 4. rename com.android.ims -> com.lge.imslegacy in Ims4 + merge the legacy closure"
+python3 "$FORGE/tools/merge-legacy-classes.py" --app "$T/smali-ims4" --legacy "$T/legacy-final" --old com/android/ims --new com/lge/imslegacy --out "$T/merged"
+
+echo ">> 5. bundle the 32-bit LG libs into the apk (patchelf-fixed) -- forces 32-bit + app-namespace load"
+PE=""; for p in patchelf-0_18 patchelf-0_17_2 patchelf; do c="$S/prebuilts/extract-tools/linux-x86/bin/$p"; [ -x "$c" ] && PE="$c" && break; done
+[ -x "$PE" ] || { echo "!! patchelf not found" >&2; exit 1; }
+mkdir -p "$T/lib/armeabi-v7a"
+for l in $LG_LIBS; do
+  src="$STOCKLIBS/$l.so"; [ -f "$src" ] || { echo "!! missing stock lib: $src" >&2; exit 1; }
+  cp "$src" "$T/lib/armeabi-v7a/$l.so"
+done
+# DT_NEEDED fixups (the blob-fixups rules, applied to the bundled copies)
+"$PE" --remove-needed libsurfaceflinger.so --add-needed libimscompat.so "$T/lib/armeabi-v7a/libims.so"
+for d in libsurfaceflinger.so libOmxCore.so libOmxVenc.so libOmxVdec.so libstagefrighthw.so libc2dcolorconvert.so; do
+  "$PE" --remove-needed "$d" "$T/lib/armeabi-v7a/libimsmmpf.so" 2>/dev/null || true
+done
+"$PE" --add-needed libimscompat.so "$T/lib/armeabi-v7a/libimsmmpf.so"
+echo "   bundled $(ls "$T/lib/armeabi-v7a" | wc -l) libs, DT_NEEDED fixed"
+
+echo ">> 6. assemble + repackage unsigned (dex + bundled libs)"
+java -jar "$SM" assemble "$T/merged" -o "$T/classes.dex"
+cp "$APK" "$OUT"
+(cd "$T" && zip -q "$OUT" classes.dex && zip -q -r "$OUT" lib)
+zip -q -d "$OUT" 'META-INF/*' >/dev/null 2>&1 || true
+echo ">> built $OUT ($(stat -c %s "$OUT") bytes, $(unzip -l "$OUT" | grep -c 'lib/armeabi-v7a/.*\.so') libs bundled) -- unsigned, for android_app_import certificate:platform"
