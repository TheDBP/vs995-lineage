From cd31b7a933aae084542059f48d1cbd21a952e0a7 Mon Sep 17 00:00:00 2001
From: T <t@e.c>
Date: Sat, 12 Sep 2026 14:08:49 -0400
Subject: [PATCH] vs995: interactive governor and HMP retune for the msm8996
 common tree

One pass over init.power.sh rather than two. The little cluster ramps sooner
(go_hispeed_load 90 -> 85, hispeed_freq 960 MHz -> 1113.6 MHz, with a target_loads
curve instead of a flat 80), the big cluster's hispeed goes 1248 -> 1478.4 MHz, input
boost reaches 1708.8 MHz on the big cluster and holds 60 ms instead of 40, and HMP
migrates to the big cores earlier (upmigrate 95 -> 85, downmigrate 90 -> 75).

These were two patches that tuned the same eight lines twice, the second revising
numbers the first had just set. The intermediate values were never a state anyone
wanted; they were a step in my own process, replayed on every build.
---
 rootdir/bin/init.power.sh | 18 +++++++++---------
 1 file changed, 9 insertions(+), 9 deletions(-)

diff --git a/rootdir/bin/init.power.sh b/rootdir/bin/init.power.sh
index d8065ab..d566b4d 100644
--- a/rootdir/bin/init.power.sh
+++ b/rootdir/bin/init.power.sh
@@ -32,11 +32,11 @@ write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor interactive
 write /sys/devices/system/cpu/cpu0/cpufreq/interactive/use_sched_load 1
 write /sys/devices/system/cpu/cpu0/cpufreq/interactive/use_migration_notif 1
 write /sys/devices/system/cpu/cpu0/cpufreq/interactive/above_hispeed_delay 19000
-write /sys/devices/system/cpu/cpu0/cpufreq/interactive/go_hispeed_load 90
+write /sys/devices/system/cpu/cpu0/cpufreq/interactive/go_hispeed_load 85
 write /sys/devices/system/cpu/cpu0/cpufreq/interactive/timer_rate 20000
-write /sys/devices/system/cpu/cpu0/cpufreq/interactive/hispeed_freq 960000
+write /sys/devices/system/cpu/cpu0/cpufreq/interactive/hispeed_freq 1113600
 write /sys/devices/system/cpu/cpu0/cpufreq/interactive/io_is_busy 1
-write /sys/devices/system/cpu/cpu0/cpufreq/interactive/target_loads 80
+write /sys/devices/system/cpu/cpu0/cpufreq/interactive/target_loads "80 1113600:85 1401600:90"
 write /sys/devices/system/cpu/cpu0/cpufreq/interactive/min_sample_time 19000
 write /sys/devices/system/cpu/cpu0/cpufreq/interactive/max_freq_hysteresis 79000
 write /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq 300000
@@ -47,9 +47,9 @@ write /sys/devices/system/cpu/cpu2/cpufreq/interactive/use_sched_load 1
 write /sys/devices/system/cpu/cpu2/cpufreq/interactive/use_migration_notif 1
 write /sys/devices/system/cpu/cpu2/cpufreq/interactive/above_hispeed_delay "19000 1400000:39000 1700000:19000 2100000:79000"
 
-write /sys/devices/system/cpu/cpu2/cpufreq/interactive/go_hispeed_load 90
+write /sys/devices/system/cpu/cpu2/cpufreq/interactive/go_hispeed_load 85
 write /sys/devices/system/cpu/cpu2/cpufreq/interactive/timer_rate 20000
-write /sys/devices/system/cpu/cpu2/cpufreq/interactive/hispeed_freq 1248000
+write /sys/devices/system/cpu/cpu2/cpufreq/interactive/hispeed_freq 1478400
 write /sys/devices/system/cpu/cpu2/cpufreq/interactive/io_is_busy 1
 write /sys/devices/system/cpu/cpu2/cpufreq/interactive/target_loads "85 1500000:90 1800000:70 2100000:95"
 
@@ -75,13 +75,13 @@ write /sys/devices/system/cpu/cpu2/cpufreq/schedutil/up_rate_limit_us 2250
 write /sys/module/msm_thermal/core_control/enabled 1
 
 # input boost configuration
-write /sys/module/cpu_boost/parameters/input_boost_freq "0:1324800 2:1324800"
-write /sys/module/cpu_boost/parameters/input_boost_ms 40
+write /sys/module/cpu_boost/parameters/input_boost_freq "0:1324800 2:1708800"
+write /sys/module/cpu_boost/parameters/input_boost_ms 60
 
 # Setting b.L scheduler parameters
 write /proc/sys/kernel/sched_migration_fixup 1
-write /proc/sys/kernel/sched_upmigrate 95
-write /proc/sys/kernel/sched_downmigrate 90
+write /proc/sys/kernel/sched_upmigrate 85
+write /proc/sys/kernel/sched_downmigrate 75
 write /proc/sys/kernel/sched_freq_inc_notify 400000
 write /proc/sys/kernel/sched_freq_dec_notify 400000
 write /proc/sys/kernel/sched_spill_nr_run 3
